# SQLite file path (optional — defaults to ./data/mailbox.sqlite)
DATABASE_URL=file:./data/mailbox.sqlite

# App auth (Better Auth) — separate from mail connector OAuth when possible
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional dedicated social apps for login (openid/email/profile only)
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
BETTER_AUTH_MICROSOFT_CLIENT_ID=
BETTER_AUTH_MICROSOFT_CLIENT_SECRET=

# Microsoft Entra app registration — mail connector (Mail.Read / Mail.Send)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/oauth/mail/callback

# Google Cloud OAuth — Gmail connector (gmail.readonly / gmail.send)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/mail/callback

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Encrypt stored mail OAuth tokens (use a long random string)
TOKEN_SECRET=
